      "headings": [
        {
          "level": "H1",
          "text": "रिकॉर्ड",
          "insidePrint": false
        },
        {
          "level": "H2",
          "text": "पुराने पर्चे से जानकारी जोड़ें",
          "insidePrint": false
        },
        {
          "level": "H2",
          "text": "फ़ाइलें — रिपोर्ट, पर्चे और स्कैन",
          "insidePrint": false
        },
        {
          "level": "H2",
          "text": "रुझान — समय के साथ आपकी रीडिंग",
          "insidePrint": false
        },
        {
          "level": "H2",
          "text": "समयरेखा",
