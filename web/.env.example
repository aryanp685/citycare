# CityCare — environment template (NG-G01). Safe to commit: NO real values, only
# generation commands. Usage:
#
#   cp .env.example .env.local
#   # then fill the <generate> lines with the inline commands
#
# Every variable below is read by the code (src/ + scripts/); nothing else is needed.
# Next.js loads .env.local automatically; the e2e suite reads it for CRON_SECRET/
# DATABASE_URL/BACKUP_KEY/BACKUP_DIR/SESSION_SECRET/RETENTION_POLICY.

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres 17/18 with role/db "citycare" (the bootstrap below creates exactly that):
#   FORCE_SEED=1 bash scripts/db-bootstrap.sh        # or, psql-free:
#   FORCE_SEED=1 node scripts/db-bootstrap-node.mjs
DATABASE_URL=postgresql://citycare:citycare@127.0.0.1:5432/citycare
# Optional: direct (non-pooled) connection — preferred when both are set (Neon Marketplace
# injects the pooled one as DATABASE_URL).
#DATABASE_URL_UNPOOLED=

# ── Core secrets — generate, never commit the real values ─────────────────────
# Session cookie signing (≥48 random bytes, hex):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Bearer secret for /api/cron/daily + /api/cron/backup (503 when unset — never open):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRON_SECRET=
# 32-byte base64 — AES-256-GCM key for uploaded documents.
# LOSING IT MAKES EVERY UPLOADED FILE UNREADABLE.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional locally: if unset, a key is *derived* from SESSION_SECRET and /api/health
# reports documentKey:"derived". For anything real, set an explicit value.
#DOCUMENT_KEY=

# ── Ledger anchoring (optional) ───────────────────────────────────────────────
# Ed25519 PKCS8 base64 — signs the daily ledger head (LedgerAnchor). Unset ⇒ anchoring skips.
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
#ANCHOR_SIGNING_KEY=
# 0 = skip the public OpenTimestamps calendars (sensible default for local dev)
#ANCHOR_OTS=0

# ── Password hashing ──────────────────────────────────────────────────────────
# Work factor (power of two) for NEW scrypt hashes. The demo seed uses 16384; the app
# default is 131072 (existing hashes rehash on login when the factor rises).
#SCRYPT_N=131072

# ── Demo / retention (NG-S15) ─────────────────────────────────────────────────
# REQUIRED declaration of this deployment's data class:
#   demo     → the daily 7-day demo-retention sweep is ARMED (also needs the banner on)
#   internal → sweep permanently OFF (real data)
#   pilot    → sweep permanently OFF (real data)
# Missing/invalid/contradictory ⇒ sweep OFF (fail-safe — an unknown environment never
# erases data). Effective policy visible at /api/health → retention.
RETENTION_POLICY=demo
# 1–365, default 7 (only meaningful when RETENTION_POLICY=demo)
#DEMO_RETENTION_DAYS=7
# 0 = hide the public-demo banner (real-data deployments set 0; that also disables the
# demo sweep by the contradiction rule)
#NEXT_PUBLIC_DEMO_MODE=1

# ── Backups (NG-S09) ──────────────────────────────────────────────────────────
# 32-byte base64 — AES-256-GCM key for ALL backup files.
# LOSING IT LOSES EVERY BACKUP. Keep separate from SESSION_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#BACKUP_KEY=
# Local backup store directory (dev). On Vercel, BLOB_READ_WRITE_TOKEN below takes
# precedence (store kind: blob > local); neither set ⇒ backups refuse to run (visible).
#BACKUP_DIR=/tmp/cc-backups
# 1–365, default 30. The newest file is always kept; pruning never goes to zero.
#BACKUP_RETENTION_DAYS=30

# ── E-mail (optional) ─────────────────────────────────────────────────────────
# Without these, all e-mail flows go to the in-app Outbox only (and the UI says so).
#RESEND_API_KEY=
#EMAIL_FROM=

# ── Grievance contact (optional) ──────────────────────────────────────────────
# Until set, the Privacy Notice shows an obvious placeholder (by design — the app
# refuses to pretend a mailbox exists).
#NEXT_PUBLIC_GRIEVANCE_OFFICER=
#NEXT_PUBLIC_GRIEVANCE_EMAIL=

# ── Scripts / display (defaults shown) ────────────────────────────────────────
#BASE=http://127.0.0.1:3000            # e2e base URL
#FORCE_SEED=1                          # db-bootstrap flag: re-seed even if users exist (pass on the command line)
#FORCE_SCHEMA=1                        # db-bootstrap flag: rebuild the schema from scratch (pass on the command line)
#TZ=UTC                                # db.ts defaults TZ to UTC when unset
#VERCEL_REGION=                        # display-only (admin system page)

# ── Vercel (production only) ──────────────────────────────────────────────────
#BLOB_READ_WRITE_TOKEN=                # Vercel Blob: the BACKUP files (private). Patient
                                       # documents are NOT stored here — they are Postgres
                                       # DocumentBlob rows inside the database.
